---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <!-- Homepage -->
  {% assign home_page = site.pages | where: "url", "/" | first %}
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ home_page.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Static content pages (about, imprint) -->
  {% assign static_about   = site.pages | where: "layout", "about" %}
  {% assign static_imprint = site.pages | where: "layout", "imprint" %}
  {% assign static_talks   = site.pages | where: "permalink", "/talks/" %}
  {% assign static_pages   = static_about | concat: static_imprint | concat: static_talks %}
  {% assign static_pages   = static_pages | where_exp: "p", "p.sitemap != false" %}
  {% for page in static_pages %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
    <lastmod>{{ page.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}

  <!-- Archive and tag pages -->
  {% assign archive_blog     = site.pages | where: "url", "/blog/" %}
  {% assign archive_tech     = site.pages | where: "url", "/tech/" %}
  {% assign archive_thoughts = site.pages | where: "url", "/thoughts/" %}
  {% assign archive_tags     = site.pages | where: "url", "/tags/" %}
  {% assign archive_tag      = site.pages | where: "layout", "tag" %}
  {% assign archive_pages = archive_blog | concat: archive_tech | concat: archive_thoughts | concat: archive_tags | concat: archive_tag %}
  {% for page in archive_pages %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.3</priority>
  </url>
  {% endfor %}

  <!-- Blog posts -->
  {% include get-blog-posts.html %}
  {% assign blog_posts = blog_posts | where_exp: "p", "p.sitemap != false" %}
  {% for post in blog_posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <!-- Curriculum vitae (unlinked from navigation, indexable) -->
  {% for cv in site.data.cv %}
  <url>
    <loc>{{ site.url }}{{ cv.path }}</loc>
    <lastmod>{{ cv.updated | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  {% endfor %}

</urlset>
